{
  "name": "reckless-chess-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "bun run typecheck && bun --bun vite build",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun --bun vitest run",
    "test:native": "bun --bun wdio run wdio.conf.ts",
    "tauri": "bun node_modules/@tauri-apps/cli/tauri.js"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "1.0.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/bun": "1.4.3",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser-playwright": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "@wdio/types": "9.32.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-vue": "2.8.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13",
    "webdriverio": "9.31.9"
  }
}
