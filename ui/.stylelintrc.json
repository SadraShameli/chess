{
  "extends": ["stylelint-config-standard"],
  "languageOptions": { "syntax": { "atRules": { "apply": { "prelude": "<declaration-value>" } } } },
  "rules": {
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "source",
          "utility",
          "variant",
          "custom-variant",
          "plugin",
          "reference",
          "apply"
        ]
      }
    ]
  }
}
